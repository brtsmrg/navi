{
  "name": "navi",
  "version": "0.1.0",
  "description": "Rally co-driver pacenotes for any road. Installable web app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "icons": "python3 scripts/make-icons.py",
    "e2e": "python3 scripts/e2e-shots.py",
    "cap:android": "npm run build && (test -d android || cap add android) && node scripts/native-patch.mjs android && cap sync android",
    "cap:ios": "npm run build && (test -d ios || cap add ios) && node scripts/native-patch.mjs ios && cap sync ios",
    "xtool:sync": "npm run build && node scripts/xtool-sync.mjs",
    "test:live": "LIVE=1 vitest run src/providers/live.test.ts",
    "notices": "node scripts/make-notices.mjs",
    "launch-check": "node scripts/launch-check.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^6.19.0",
    "onnxruntime-web": "^1.31.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
